[Unit]
Description=Open a verified current native release after recorder startup recovery
After=argentum-play.service argentum-web.service
Requires=argentum-play.service argentum-web.service
ConditionPathExists=/etc/argentum-play/release-approved
ConditionPathExists=/etc/argentum-play/recording-approved
ConditionPathExists=/etc/argentum-play/network-approved
ConditionPathExists=/etc/argentum-play/updater-policy.json

[Service]
Type=oneshot
User=root
StateDirectory=argentum-updater
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/libexec/argentum-native/host_adapter.py admit-current
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/srv/commander-runtime /var/lib/commander-gym/state /var/lib/commander-gym/imports
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=50%
TasksMax=64
TimeoutStartSec=120

