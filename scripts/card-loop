#!/usr/bin/env bash
# Implement the missing cards of a card list (a decklist export, or one name per line) with headless
# Claude Code or Codex, one fresh session per step.
#   just card-loop <list-file> [model] [--local]    e.g. just card-loop decks/dina.txt astra --local
# Stop it with Ctrl-C, or `touch .claude/loop-runs/cards-<list>.stop` to stop after the current step.
# When the subscription's usage limit is hit, it waits and retries.
set -uo pipefail

models() {
  cat <<'EOF2'
Model       CLI           Selection
sonnet      Claude Code   Claude's sonnet alias
opus        Claude Code   Claude's opus alias
astra       Codex         gpt-6-astra

Full claude-* and gpt-* model IDs also work.
Use codex:<model-id> to select any Codex model ID.
GPT model IDs are normalized to lowercase; other IDs pass through unchanged.
Omitting the model uses MODEL, or claude-opus-5-5 when MODEL is unset.
EOF2
}

usage() {
  cat <<'EOF2'
Usage: just card-loop <list-file> [model] [--local]

Implements every card of <list-file> the engine doesn't have yet. The list is a decklist export
(Moxfield, Archidekt, MTGA: "1 Sol Ring (C21) 263", section headers, comments) or one card name per
line; `scripts/card-list-status <list-file>` shows which of its cards are missing. Cards that compose
from existing primitives ship in batches; cards that need new engine vocabulary are triaged into
gaps and built one capability at a time.

Default: one reviewed PR per unit, merged once CI is green, like set-loop.
--local:  no pushes, PRs or merges. Every unit is reviewed and committed on one local branch,
          loop-cards-<list>-local, rebased onto origin/main as it goes. When the list is done, push
          that branch and open a single PR yourself.

Ledger, triage and status live in .claude/loop-runs/cards-<list>-*.md.

Examples:
  just card-loop dina.txt                          # claude-opus-5-5, a PR per unit
  just card-loop dina.txt astra --local            # Codex gpt-6-astra, local commits only
  just card-loop dina.txt codex:gpt-6-sol --local
  just card-loop dina.txt pick                     # Choose from a menu
  just card-loop --models                          # Show model shortcuts

EOF2
  models
}

LOCAL=false
ARGS=()
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    --models) models; exit 0 ;;
    --local) LOCAL=true ;;
    -*) echo "card-loop: unknown option '$arg'" >&2; usage >&2; exit 2 ;;
    '') ;;
    *) ARGS+=("$arg") ;;
  esac
done
if [ "${#ARGS[@]}" -lt 1 ] || [ "${#ARGS[@]}" -gt 2 ]; then usage >&2; exit 2; fi

LIST=${ARGS[0]}
[ -f "$LIST" ] || { echo "card-loop: no such card list: $LIST" >&2; exit 2; }
LIST="$(cd "$(dirname "$LIST")" && pwd)/$(basename "$LIST")"
SLUG=$(basename "$LIST" | sed -E 's/\.[A-Za-z0-9]+$//' | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
[ -n "$SLUG" ] || SLUG=list
NAME="cards-$SLUG"
PREFIX="loop-$NAME-"

MODEL=${ARGS[1]:-${MODEL:-claude-opus-5-5}}
if [ "$MODEL" = pick ]; then
  if [ ! -t 0 ]; then
    echo "card-loop: pick needs a terminal; pass sonnet, opus, astra, or a full model ID" >&2
    exit 2
  fi
  PS3="Choose a model (Ctrl-C to cancel): "
  select choice in sonnet opus astra "Custom Codex model"; do
    case "$choice" in
      "Custom Codex model")
        read -r -p "Codex model ID: " custom_model || exit 2
        if [ -z "$custom_model" ]; then
          echo "Enter a model ID." >&2
          continue
        fi
        MODEL="codex:$custom_model"
        break
        ;;
      "") echo "Choose 1, 2, 3, or 4." >&2 ;;
      *) MODEL=$choice; break ;;
    esac
  done
  [ "$MODEL" != pick ] || exit 2
fi
# Codex's picker displays GPT names with capitals, but its model IDs are lowercase.
# Normalize only GPT IDs so custom provider IDs keep their original spelling.
case "$MODEL" in
  [gG][pP][tT]-*|codex:[gG][pP][tT]-*)
    NORMALIZED_MODEL=$(printf '%s' "$MODEL" | tr '[:upper:]' '[:lower:]')
    if [ "$MODEL" != "$NORMALIZED_MODEL" ]; then
      echo "card-loop: model '$MODEL' normalized to '$NORMALIZED_MODEL'"
      MODEL=$NORMALIZED_MODEL
    fi
    ;;
esac
case "$MODEL" in
  codex:)
    echo "card-loop: codex: requires a model ID" >&2
    exit 2
    ;;
  codex:*) MODEL=${MODEL#codex:}; HARNESS=codex ;;
  astra) MODEL=gpt-6-astra; HARNESS=codex ;;
  gpt-*) HARNESS=codex ;;
  *) HARNESS=claude ;;
esac
command -v "$HARNESS" >/dev/null || { echo "card-loop: $HARNESS is not installed" >&2; exit 1; }
REPO=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
RUNS="$REPO/.claude/loop-runs"
mkdir -p "$RUNS"
# shellcheck source=loop-lib.sh
source "$(dirname "$0")/loop-lib.sh"
LOCAL_FLAG=""
$LOCAL && LOCAL_FLAG=--local
loop_maybe_tui "$NAME" "$0" "$LIST" "$(loop_model_arg)" $LOCAL_FLAG

LEDGER="$RUNS/$NAME-cards.md"
GAPS="$RUNS/$NAME-gaps.md"
STATUS="$RUNS/$NAME-status.md"
BRANCH="${PREFIX}local"
WT="$REPO/.claude/worktrees/$BRANCH"

TRIAGE="Triage format ($GAPS), three sections:
'## Gaps' — one line per distinct missing capability: \`- [ ] G<n> <capability> — unlocks <k>: <cards> — deps: <G ids or none>\`.
  Collapse near-duplicates; a gap is engine/SDK vocabulary, never a single card's quirk composition can express.
  Commander-only rules (\"if you control a commander\", command-zone casting, commander tax, partner) are gaps like any other.
'## Ready' — cards that compose from existing primitives today, one per line, in list order.
'## Triaged' — every missing card already triaged (READY, BLOCKED or dropped), so a later step knows what's left.

The status file is the list's missing cards: \`scripts/card-list-status '$LIST' --out $STATUS\`. It reads what's
implemented from the checkout it runs in, so run it at the start of every build or triage step rather than
trusting an old copy."

BATCH="Take up to 15 '## Ready' cards in list order. Hand them to ONE subagent (two, each with half, if more than
   eight cards) that reads the add-card skill and SDK reference once and implements the cards one after another,
   writing files only — no git, no \`just\`, no builds; the single gate is the only build. Use the add-card skill:
   each canonical in its earliest real printing's set, \`Printing\` rows in every scaffolded set that reprints it
   (\`scripts/generate-reprints.py --since origin/main\`), a scenario test only when add-card says the card earns one
   (one test file per card, never a shared one). A card that turns out to need new vocabulary — or could only ship
   as a \"known approximation\" (an engine path, mana type or event that doesn't match the printed text exactly) —
   is dropped from the batch and added to '## Gaps' as a new \`[ ]\` gap."

GAP="Take the first such gap, mark it \`[~]\`, and build it with the add-feature skill: the capability, its SDK
   reference entry, engine tests, plus one or two of the cards it unlocks as proof (one scenario test file per card)."

SCAFFOLD="A card whose earliest real printing is in a set that isn't scaffolded yet (\`just check-card-printing\` says NOT
SCAFFOLDED) is an ordinary '## Ready' card, never needs-human and never a reason to answer STUCK: scaffold that set
yourself. Add its \`MtgSet\` object in the era module for its release year (mirror a neighbour; set
\`override val incomplete = true\`, plus \`sealedSupported = false\` unless it is a draftable expansion), put the
canonical there, and give every card of that set that is already implemented its \`Printing\` row too. To do that,
list the set's Scryfall cards that already have a \`card(\"Name\")\` in mtg-sets, run \`just check-card-printing\` on
each one (that refreshes its cache), then run \`scripts/generate-reprints.py --set <CODE> --cards-from <list>\`.
Relocate any canonical it reports as misplaced."

if $LOCAL; then
  PROMPT="You are one iteration of an unattended loop that implements the missing cards of the card list
$LIST in Argentum, one reviewed unit at a time, committed LOCALLY. You are a fresh session: your memory is
the ledger at $LEDGER (create it if missing), the triage at $GAPS, the status at $STATUS, and the git log of
the branch '$BRANCH'. None of the files is committed. Do exactly ONE of the steps below, then stop.

LOCAL MODE — the human opens one PR themselves once the list is done. Never push, never open, comment on or merge a
PR, never wait for CI; \`gh\` is for read-only lookups at most. All work happens on the branch '$BRANCH' in the worktree $WT (create it with
\`git worktree add -b $BRANCH $WT origin/main\` after a \`git fetch\` if it's missing; reuse it if it exists). Never
work in the main checkout, and never touch a branch or worktree other than this one. Other loops may be running.

Start of every step: in the worktree, if there are uncommitted changes (an earlier session died mid-unit), finish
that unit (gate, review, commit) as this step. Otherwise \`git fetch\` and \`git rebase origin/main\`; resolve
conflicts in snapshot goldens or generated files by re-blessing / re-baking, not by hand-merging; if a conflict
can't be resolved cleanly, \`git rebase --abort\` and carry on from the current base, noting it in the ledger.
Then regenerate the status file in the worktree. Don't duplicate work in flight: when triaging, check the open PRs
of wingedsheep/argentum-engine (\`gh pr list --repo wingedsheep/argentum-engine --state open --search '<card name>'\`
if \`gh\` is available, else skip the check) and mark a card another open PR already adds as 'in PR #<n>' in
'## Triaged' instead of implementing it.

$TRIAGE

1. Uncommitted work in the worktree -> finish it as above.
2. The status file lists missing cards not in '## Triaged' -> triage, no commit. Take up to 40 untriaged missing cards.
   Fan them out to subagents in chunks, each checking Scryfall oracle text (and rulings) against
   docs/card-sdk-language-reference.md and the source, returning one line per card: READY, or BLOCKED on a named
   missing capability. \`just assay compile \"<Card>\"\` printing a whole CardDefinition is strong evidence for READY.
   Merge the answers into the triage file (re-verify any existing gap line a card would join — they go stale), order
   '## Gaps' by dependencies first, then most cards unlocked. Stop after writing it.
3. '## Ready' is empty and an unticked gap has all deps \`[x]\` -> engine gap. $GAP
4. '## Ready' has cards -> card batch. $BATCH

COMMITTING A UNIT (steps 3 and 4):
- Gate with \`just loop-gate --rebless\` from the worktree (the snapshot goldens are re-blessed in the same build;
  check from the printed diff that only your cards moved) and \`just check-card-printing\` per card. Never run
  \`just build\`, \`just test\` or any \`just e2e*\` recipe. A new or changed player-visible flow (an engine gap with
  a decision or prompt) gets a manual UI check as AGENTS.md describes; card-only batches skip it.
- Review the unit's diff (\`git diff HEAD\` plus new files) with the review-changes skill in SPLIT MODE: you wrote
  the code, so you only dispatch — one TRIAGE subagent, then (unless it reviewed a single-area diff in a single
  pass) one subagent per area it names (at most three) and one WEIGH subagent, each a fresh context, with the review
  dir \`$WT/.claude/loop-runs/review-$BRANCH/\`. A diff of only card definitions, their tests and goldens is reviewed
  in a single pass by TRIAGE. Tell each that \`just loop-gate\` already passed, so nobody re-runs tests. Fix the
  findings WEIGH calls blocking or important; you may decline one only with a stated reason. Re-gate if anything
  changed. Without subagents (e.g. Codex), run the skill's sequential mode.
- Commit once, titled '[agent-loop: $MODEL] Add <N> cards from $SLUG' (a card batch) or
  '[agent-loop: $MODEL] <capability>' (a gap), whose body lists the cards (card, canonical set + number, what it's
  built from), dropped cards with the gap they need, the review's fixes and declines, the gate run, and that nothing
  was play-tested. Then bookkeeping: record the unit and its commit sha in the ledger; tick a closed gap \`[x]\` and
  move the cards it unlocked (minus any it shipped) into '## Ready'; remove shipped cards from '## Ready'.

$SCAFFOLD

If a unit fails twice, mark it needs-human in the ledger (and the gap \`[!]\` if it was one), \`git restore\` and
\`git clean\` only the files that unit created in the worktree, and move on. Cards blocked on a \`[!]\` gap are skipped.
When the regenerated status file lists no missing cards except ones marked 'in PR #<n>', answer CARDS_COMPLETE (the
ledger names those PRs). When every remaining missing card is blocked on a \`[!]\` gap, answer STUCK naming those gaps.
Follow AGENTS.md. Never revert or stash work that isn't yours.
An unrelated failure on origin/main (a test in a module your change doesn't touch) is NOT a reason to answer
STUCK: run the gates for the modules you changed, note the unrelated failure in the ledger and the commit body,
and carry on. Only answer STUCK when the failure is inside code your unit changed or depends on."
else
  PROMPT="You are one iteration of an unattended loop that implements the missing cards of the card list
$LIST in Argentum, one reviewed PR at a time. You are a fresh session: your memory is the ledger at
$LEDGER (create it if missing), the triage at $GAPS, the status at $STATUS, and GitHub. None of them is
committed. Do exactly ONE of the steps below, then stop — except that merging a PR is followed by the next build
step in the same session.

Other loops may be running at the same time, so everything this loop owns is named by the prefix '$PREFIX':
every branch you create is '$PREFIX<short-slug>', and its worktree is $REPO/.claude/worktrees/$PREFIX<short-slug>.
Find our open PR by branch name only:
\`gh pr list --author @me --state open --json number,headRefName --jq '.[] | select(.headRefName | startswith(\"$PREFIX\"))'\`
Never touch a PR, branch or worktree without our prefix. Work on our PR in its worktree (recreate it with
\`git worktree add\` if missing). Never work in the main checkout. A card another open PR (any author) already
adds is skipped, not duplicated.

$TRIAGE

1-4. Our PR is open -> follow the PR LIFECYCLE below (CI failed, conflicts, unreviewed, or ready to merge).
   Merge bookkeeping: record the unit in the ledger. If it closed a gap, tick it \`[x]\` and move
   the cards it unlocked (minus any it shipped) into '## Ready'. Remove shipped cards from '## Ready'.
5. No PR open, and the status file (regenerated in a worktree '${PREFIX}triage' off fresh origin/main) lists missing
   cards not in '## Triaged' -> triage, no PR. Take up to 40 untriaged missing cards. Fan them out to subagents in
   chunks, each checking Scryfall oracle text (and rulings) against docs/card-sdk-language-reference.md and the
   source, returning one line per card: READY, or BLOCKED on a named missing capability.
   \`just assay compile \"<Card>\"\` printing a whole CardDefinition is strong evidence for READY. Merge the answers
   into the triage file (re-verify any existing gap line a card would join — they go stale), order '## Gaps' by
   dependencies first, then most cards unlocked. Remove the worktree. Stop after writing it.
6. No PR open, '## Ready' is empty, and an unticked gap has all deps \`[x]\` -> engine gap. \`git fetch\`, new
   worktree + '$PREFIX' branch from origin/main. $GAP Gate, commit, review, push, open a PR titled
   '[agent-loop: $MODEL] <capability> for $SLUG' whose body names the gap, the cards it unlocks, the
   gate run, and that nothing was play-tested. Record the unit in the ledger.
7. No PR open, '## Ready' has cards -> card batch. \`git fetch\`, new worktree + '$PREFIX' branch from origin/main.
   $BATCH Gate once with \`just loop-gate --rebless\` and \`just check-card-printing\` per card, commit, push, and open
   a PR titled '[agent-loop: $MODEL] Add <N> cards from $SLUG' whose body has a table of the cards
   (card, canonical set + number, what it's built from), dropped cards with the gap they need, the gate run, and
   that nothing was play-tested. Record the unit in the ledger.

$SCAFFOLD If that comes to more than about 15 rows, ship the scaffold and its rows as their own PR first.

If a step fails twice for the same PR, comment on it, mark it needs-human in the ledger (and the gap \`[!]\` if it
was one), and move on. Cards blocked on a \`[!]\` gap are skipped. When the regenerated status file lists no
missing cards, answer CARDS_COMPLETE. When every missing card is blocked on a \`[!]\` gap, answer STUCK naming
those gaps.
Follow AGENTS.md. Never revert or stash work that isn't yours.
An unrelated failure on origin/main (a test in a module your change doesn't touch) is NOT a reason to answer
STUCK: run the gates for the modules you changed, note the unrelated failure in the ledger and the PR body,
and carry on. Only answer STUCK when the failure is inside code your unit changed or depends on.

$LOOP_PR_PROTOCOL"
fi

PROMPT="$PROMPT

A human watches your text live, one line at a time, so keep them posted in short lines (under 150 chars each):
- once you know which step you're taking: 'Working on: <step and unit, e.g. step 4, 12 cards incl. Ad Nauseam>'
- whenever you learn something that changes the plan — a gap found, a card dropped as needing vocabulary, a
  failure's cause, a review finding you fixed or declined: 'Finding: <one line>'
- just before your final line, one to three lines: 'Summary: <what you did / what's next>'
No other long prose.
End your reply with exactly one line: STEP <n> DONE | WAITING_CI | CARDS_COMPLETE | STUCK <reason>"
if [ "$HARNESS" = codex ]; then
  PROMPT="$PROMPT

Read the applicable skill files in .agents/skills/ (add-card/SKILL.md, add-feature/SKILL.md,
review-changes/SKILL.md, verify/SKILL.md). If subagents are unavailable, perform their steps inline."
elif [ "$MODEL" = sonnet ] || [ "$MODEL" = opus ]; then
  PROMPT="$PROMPT

The requested model '$MODEL' is a Claude alias. Before the first commit, resolve the actual driving
model ID from your session's system information and use it instead of '$MODEL' in every
[agent-loop: ...] title and model attribution. Never guess a version; if it cannot be determined,
answer STUCK cannot determine driving model ID."
fi

# Everything the loop prints also goes to the run log.
LOGDIR="$RUNS/$NAME-logs"
mkdir -p "$LOGDIR"
exec > >(tee -a "$RUNS/$NAME.log") 2>&1
loop_clear_stale_stop "$RUNS/$NAME.stop" "$RUNS/$NAME.pid"
# `just loops` reads this to tell a running loop from a finished one.
echo $$ > "$RUNS/$NAME.pid"
trap 'rm -f "$RUNS/$NAME.pid"' EXIT
log() { echo "[$(date '+%F %T')] $*"; }

# Streamed live: the milestones the session reports (Working on / Finding / Summary), nothing else.
# LOOP_VERBOSE=1 adds its other messages and every tool call. `just loops` is the at-a-glance view.
[ -n "${LOOP_VERBOSE:-}" ] && VERBOSE=true || VERBOSE=false
MILESTONE='def milestone: (if startswith("Working on") then "   🔨 " elif startswith("Finding") then "   🔎 " else "   📋 " end) + .[0:200];'
PRETTY="$MILESTONE"'select(.type == "assistant") | .message.content[]? |
  (if .type == "text" then
     ([.text | split("\n")[] | select(test("^(Working on|Finding|Summary):"))]) as $m
     | if ($m | length) > 0 then $m[] | milestone
       elif $verbose then "   💬 " + (.text | split("\n")[0] | .[0:160]) else empty end
   elif .type == "tool_use" and $verbose then "   → " + .name + ": " +
     ((.input.description // .input.command // .input.skill // .input.file_path // .input.pattern
       // .input.prompt // "") | tostring | split("\n")[0] | .[0:140])
   else empty end)'

if [ "$HARNESS" = codex ]; then
  PRETTY="$MILESTONE"'if .type == "item.completed" and .item.type == "agent_message" then
      .item.text | split("\n")[] | select(length > 0)
      | if test("^(Working on|Finding|Summary):") then milestone elif $verbose then "   💬 " + .[0:200] else empty end
    elif .type == "item.started" and .item.type == "command_execution" and $verbose then
      "   → " + (.item.command | split("\n")[0] | .[0:140])
    elif .type == "error" or .type == "turn.failed" then
      "   ! " + (.message // .error.message // "Codex turn failed")
    else empty end'
fi

# Stamp each rendered line when received, using the same local clock as launcher events.
PRETTY="($PRETTY)"' | "[" + (now | strflocaltime("%Y-%m-%d %H:%M:%S")) + "] " + .'

$LOCAL && RUN_MODE="local commits on $BRANCH" || RUN_MODE="a PR per unit"
log "card-loop started (list $LIST, $RUN_MODE, harness $HARNESS, model $MODEL, log $RUNS/$NAME.log)"
N=0
while [ ! -e "$RUNS/$NAME.stop" ]; do
  N=$((N + 1))
  PR=""
  if ! $LOCAL; then
    loop_await_turn "$PREFIX"
    PR=$LOOP_PRS
  fi
  [ -e "$RUNS/$NAME.stop" ] && break

  loop_session_acquire "$RUNS/$NAME.stop" || break
  SESSION_START=$SECONDS
  TRANSCRIPT="$LOGDIR/$(date '+%Y%m%d-%H%M%S')-iter$N.jsonl"
  log "iteration $N (PR: ${PR:-none}) — transcript $TRANSCRIPT"
  if [ "$HARNESS" = codex ]; then
    FINAL_FILE="${TRANSCRIPT%.jsonl}.txt"
    # A failed launch must never reuse a stale completion marker.
    rm -f "$FINAL_FILE"
    (cd "$REPO" && codex exec --model "$MODEL" --approve-for-me --json \
        --output-last-message "$FINAL_FILE" "$PROMPT" 2>&1) \
      | tee "$TRANSCRIPT" | jq -Rr --unbuffered --argjson verbose "$VERBOSE" "fromjson? | $PRETTY"
    SESSION_STATUS=$?
    RESULT=$(cat "$FINAL_FILE" 2>/dev/null || true)
    FINAL=$RESULT
    STATS="exit $SESSION_STATUS"
  else
    (cd "$REPO" && loop_run_reaped "$TRANSCRIPT" CARDS_COMPLETE \
        claude -p "$PROMPT" --model "$MODEL" --permission-mode "${PERMISSION_MODE:-auto}" \
        --output-format stream-json --verbose 2>&1) \
      | tee "$TRANSCRIPT" | jq -Rr --unbuffered --argjson verbose "$VERBOSE" "fromjson? | $PRETTY"
    loop_note_reaped "$TRANSCRIPT"

    FINAL=$(jq -Rc 'fromjson? | select(.type == "result")' "$TRANSCRIPT" 2>/dev/null | tail -1)
    RESULT=$(echo "$FINAL" | jq -r '.result // empty' 2>/dev/null)

    # A session reports a result each time it wakes for a background task, so the last one's
    # duration is only its tail: time the session by the wall clock instead.
    STATS=$(echo "$FINAL" | jq -r '"$\(.total_cost_usd // 0 | . * 100 | round / 100) at API prices"' 2>/dev/null)
  fi
  LAST=$(echo "$RESULT" | tail -1)
  STATS="$(( (SECONDS - SESSION_START) / 60 )) min, $STATS"
  log "iteration $N finished: ${LAST:-<no result>} ($STATS)"
  loop_session_release

  # A session that ended on its protocol line finished its step; any "rate limit" in its text is
  # its own prose (e.g. a Scryfall 429 it reported), not the harness stopping it.
  if ! grep -qE '^(STEP [0-9]+ DONE|WAITING_CI|[A-Z]+_COMPLETE|STUCK)' <<<"$LAST" &&
     grep -qiE 'usage limit|session limit|hit your limit|rate limit|overloaded|quota exceeded' <<<"$RESULT$(tail -5 "$TRANSCRIPT")"; then
    log "limit reached — waiting 15 min"; sleep 900; continue
  fi
  if [ "$HARNESS" = codex ] && { [ "$SESSION_STATUS" -ne 0 ] || [ -z "$FINAL" ]; }; then
    log "Codex failed or returned no final message — see $TRANSCRIPT"
    tail -5 "$TRANSCRIPT"
    exit 1
  fi
  if [ -z "$FINAL" ]; then
    log "no result — waiting 30 min"; sleep 1800; continue
  fi
  case $LAST in
    WAITING_CI*)     log "session saw CI pending — waiting on it next iteration" ;;
    CARDS_COMPLETE*)
      log "every card in $(basename "$LIST") is implemented"
      $LOCAL && log "the work is on branch $BRANCH ($WT) — push it and open one PR"
      exit 0 ;;
    STUCK*)          log "stuck — see the ledger at $LEDGER"; exit 1 ;;
  esac
done
log "stop file found — stopping"
rm -f "$RUNS/$NAME.stop"
