// Cloud Key
{
    "name": "Cloud Key",
    "manaCost": "{3}",
    "typeLine": "Artifact",
    "oracleText": "As this artifact enters, choose artifact, creature, enchantment, instant, or sorcery.\nSpells you cast of the chosen type cost {1} less to cast.",
    "script": {
        "staticAbilities": [
            {
                "type": "ModifySpellCost",
                "target": {
                    "type": "YouCast",
                    "filter": {
                        "cardPredicates": [
                            "CardTypeEqualsChosenComponent"
                        ]
                    }
                },
                "modification": {
                    "type": "ReduceGeneric",
                    "amount": 1
                }
            }
        ],
        "replacementEffects": [
            {
                "type": "EntersWithChoice",
                "choiceType": "CARD_TYPE",
                "allowedCardTypes": [
                    "ARTIFACT",
                    "CREATURE",
                    "ENCHANTMENT",
                    "INSTANT",
                    "SORCERY"
                ]
            }
        ]
    },
    "metadata": {
        "collectorNumber": "160",
        "rarity": "RARE",
        "artist": "Trevor Hairsine",
        "imageUri": "https://cards.scryfall.io/normal/front/b/8/b893ab56-44a6-4b3c-bb3e-6deec298cbce.jpg?1783943092",
        "rulings": [
            {
                "date": "2021-03-19",
                "text": "The cost reduction applies only to generic mana in the cost of spells of the chosen type you cast."
            },
            {
                "date": "2021-03-19",
                "text": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as a flashback cost), add any cost increases (such as kicker costs), then apply any cost reductions (such as that of Cloud Key's ability). The mana value of the spell is determined by only its mana cost, no matter what the total cost to cast that spell was."
            }
        ]
    },
    "colorIdentityOverride": []
}

// Coalition Relic
{
    "name": "Coalition Relic",
    "manaCost": "{3}",
    "typeLine": "Artifact",
    "oracleText": "{T}: Add one mana of any color.\n{T}: Put a charge counter on this artifact.\nAt the beginning of your first main phase, remove all charge counters from this artifact. Add one mana of any color for each charge counter removed this way.",
    "script": {
        "triggeredAbilities": [
            {
                "id": "ability_1",
                "trigger": {
                    "type": "StepEvent",
                    "step": "PRECOMBAT_MAIN"
                },
                "binding": "ANY",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "StoreNumber",
                            "name": "removedChargeCounters",
                            "amount": {
                                "type": "EntityProperty",
                                "entity": "Source",
                                "numericProperty": {
                                    "type": "CounterCount",
                                    "counterType": {
                                        "type": "Named",
                                        "name": "charge"
                                    }
                                }
                            }
                        },
                        {
                            "type": "RemoveAllCountersOfType",
                            "counterType": "charge",
                            "target": "Self"
                        },
                        {
                            "type": "AddDynamicMana",
                            "amountSource": {
                                "type": "VariableReference",
                                "variableName": "removedChargeCounters"
                            },
                            "allowedColors": [
                                "WHITE",
                                "BLUE",
                                "BLACK",
                                "RED",
                                "GREEN"
                            ]
                        }
                    ]
                }
            }
        ],
        "activatedAbilities": [
            {
                "id": "ability_2",
                "cost": "CostTap",
                "effect": "AddManaOfChoice",
                "timing": "ManaAbility",
                "isManaAbility": true
            },
            {
                "id": "ability_3",
                "cost": "CostTap",
                "effect": {
                    "type": "AddCounters",
                    "counterType": "charge",
                    "count": 1,
                    "target": "Self"
                }
            }
        ]
    },
    "metadata": {
        "collectorNumber": "161",
        "rarity": "RARE",
        "artist": "Donato Giancola",
        "imageUri": "https://cards.scryfall.io/normal/front/7/a/7a7c98b0-d64d-4d0a-b284-1187a8e7095e.jpg?1783943092",
        "rulings": [
            {
                "date": "2021-03-19",
                "text": "If you remove multiple charge counters from Coalition Relic at once, you may add a different color of mana for each one."
            },
            {
                "date": "2021-03-19",
                "text": "Only the first main phase each turn is considered a precombat main phase, even if additional main phases or combat phases are created."
            }
        ]
    },
    "colorIdentityOverride": []
}

