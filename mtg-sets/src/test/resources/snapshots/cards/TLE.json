// Toph, Earthbending Master
{
    "name": "Toph, Earthbending Master",
    "manaCost": "{3}{G}",
    "typeLine": "Legendary Creature — Human Warrior Ally",
    "oracleText": "Landfall — Whenever a land you control enters, you get an experience counter.\nWhenever you attack, earthbend X, where X is the number of experience counters you have. (Target land you control becomes a 0/0 creature with haste that's still a land. Put X +1/+1 counters on it. When it dies or is exiled, return it to the battlefield tapped.)",
    "creatureStats": {
        "power": 2,
        "toughness": 4
    },
    "script": {
        "triggeredAbilities": [
            {
                "id": "Toph, Earthbending Master:1",
                "trigger": {
                    "type": "ZoneChangeEvent",
                    "filter": "land ctrl:you",
                    "to": "Battlefield"
                },
                "binding": "ANY",
                "effect": {
                    "type": "AddCounters",
                    "counterType": "EXPERIENCE",
                    "count": 1,
                    "target": "Controller"
                }
            },
            {
                "id": "Toph, Earthbending Master:2",
                "trigger": "YouAttackEvent",
                "binding": "ANY",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "AnimateLand",
                            "target": {
                                "type": "BoundVariable",
                                "name": "t0"
                            },
                            "power": 0,
                            "toughness": 0,
                            "duration": "Permanent"
                        },
                        {
                            "type": "GrantKeyword",
                            "keyword": "HASTE",
                            "target": {
                                "type": "BoundVariable",
                                "name": "t0"
                            },
                            "duration": "Permanent"
                        },
                        {
                            "type": "AddDynamicCounters",
                            "counterType": "PLUS_ONE_PLUS_ONE",
                            "amount": {
                                "type": "PlayerCounterCount",
                                "counterType": "EXPERIENCE"
                            },
                            "target": {
                                "type": "BoundVariable",
                                "name": "t0"
                            }
                        },
                        {
                            "type": "GrantTriggeredAbility",
                            "ability": {
                                "id": "earthbend_return_tapped",
                                "trigger": {
                                    "type": "ZoneChangeEvent",
                                    "from": "Battlefield"
                                },
                                "effect": {
                                    "type": "Composite",
                                    "effects": [
                                        {
                                            "type": "MoveToZone",
                                            "target": "Self",
                                            "destination": "Battlefield",
                                            "placement": "Tapped",
                                            "fromZone": "Graveyard"
                                        },
                                        {
                                            "type": "MoveToZone",
                                            "target": "Self",
                                            "destination": "Battlefield",
                                            "placement": "Tapped",
                                            "fromZone": "Exile"
                                        }
                                    ]
                                },
                                "descriptionOverride": "When this dies or is exiled, return it to the battlefield tapped."
                            },
                            "target": {
                                "type": "BoundVariable",
                                "name": "t0"
                            },
                            "duration": "Permanent"
                        },
                        {
                            "type": "EmitBendEvent",
                            "bendType": "EARTH"
                        }
                    ]
                },
                "targetRequirement": {
                    "type": "TargetObject",
                    "filter": {
                        "baseFilter": "land ctrl:you"
                    },
                    "id": "t0"
                },
                "descriptionOverride": "Whenever you attack, earthbend X, where X is the number of experience counters you have."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "145",
        "rarity": "MYTHIC",
        "artist": "Phima",
        "imageUri": "https://cards.scryfall.io/normal/front/2/2/22d1b078-9175-45ab-8fbe-ed4af2abde1f.jpg?1783904811",
        "rulings": [
            {
                "date": "2025-10-02",
                "text": "All experience counters are identical, no matter how you got them. For example, the last ability will count experience counters that you got from the first ability, from another ability, from another copy of Toph, Earthbending Master, and so on."
            },
            {
                "date": "2025-10-02",
                "text": "The experience counter goes on you, the player, not on Toph. You will keep that counter even if Toph, Earthbending Master dies."
            },
            {
                "date": "2025-10-02",
                "text": "You may target a land that is already a creature, perhaps because of a previous earthbend ability. The land will get the +1/+1 counters, gain haste, and have its base power and toughness set to 0/0."
            }
        ]
    },
    "colorIdentityOverride": [
        "GREEN"
    ]
}

