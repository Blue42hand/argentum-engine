// Monk Gyatso
{
    "name": "Monk Gyatso",
    "manaCost": "{3}{W}",
    "typeLine": "Legendary Creature — Human Monk",
    "oracleText": "Whenever another creature you control becomes the target of a spell or ability, you may airbend that creature. (Exile it. While it's exiled, its owner may cast it for {2} rather than its mana cost.)",
    "creatureStats": {
        "power": 3,
        "toughness": 3
    },
    "script": {
        "triggeredAbilities": [
            {
                "id": "Monk Gyatso:1",
                "trigger": {
                    "type": "BecomesTargetEvent",
                    "targetFilter": "creature ctrl:you"
                },
                "binding": "OTHER",
                "effect": {
                    "type": "Gated",
                    "gate": "Gate.MayDecide",
                    "then": {
                        "type": "Composite",
                        "effects": [
                            {
                                "type": "GatherCards",
                                "source": "TriggeringEntity",
                                "storeAs": "airbendTriggering"
                            },
                            {
                                "type": "FilterCollection",
                                "from": "airbendTriggering",
                                "filter": {
                                    "cardPredicates": [
                                        "IsPermanent"
                                    ],
                                    "statePredicates": [
                                        "IsOnBattlefield"
                                    ]
                                },
                                "storeMatching": "airbendChosen"
                            },
                            {
                                "type": "MoveCollection",
                                "from": "airbendChosen",
                                "destination": {
                                    "type": "ToZone",
                                    "zone": "Exile"
                                },
                                "storeMovedAs": "airbendExiled"
                            },
                            {
                                "type": "GrantMayPlayFromExile",
                                "from": "airbendExiled",
                                "expiry": "Permanent",
                                "ownerControls": true,
                                "fixedAlternativeManaCost": "{2}"
                            },
                            {
                                "type": "Gated",
                                "gate": {
                                    "type": "Gate.WhenCondition",
                                    "condition": {
                                        "type": "CollectionContainsMatch",
                                        "collection": "airbendExiled"
                                    }
                                },
                                "then": {
                                    "type": "EmitBendEvent",
                                    "bendType": "AIR"
                                }
                            }
                        ]
                    }
                },
                "descriptionOverride": "Whenever another creature you control becomes the target of a spell or ability, you may airbend that creature."
            }
        ]
    },
    "metadata": {
        "collectorNumber": "81",
        "rarity": "RARE",
        "artist": "Masateru Ikeda",
        "flavorText": "\"My ancient cake-making technique isn't the only thing on your mind, is it, Aang?\"",
        "imageUri": "https://cards.scryfall.io/normal/front/e/2/e27ed185-eb2b-42dd-b48e-3c8d4456268b.jpg?1783904834",
        "rulings": [
            {
                "date": "2025-10-02",
                "text": "Tokens exiled this way will cease to exist and cannot be cast."
            },
            {
                "date": "2025-10-02",
                "text": "Lands exiled this way cannot be played from exile. (Lands that were animated by earthbend will be returned to the battlefield tapped when they're exiled.)"
            }
        ]
    },
    "colorIdentityOverride": [
        "WHITE"
    ]
}

