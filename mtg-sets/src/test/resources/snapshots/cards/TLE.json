// Mai and Zuko
{
    "name": "Mai and Zuko",
    "manaCost": "{1}{U}{B}{R}",
    "typeLine": "Legendary Creature — Human Noble Ally",
    "oracleText": "Firebending 3\nYou may cast Ally spells and artifact spells as though they had flash.",
    "creatureStats": {
        "power": 3,
        "toughness": 5
    },
    "keywords": [
        "FIREBENDING"
    ],
    "keywordAbilities": [
        {
            "type": "Numeric",
            "keyword": "FIREBENDING",
            "n": 3
        }
    ],
    "script": {
        "triggeredAbilities": [
            {
                "id": "Mai and Zuko:1",
                "trigger": "AttackEvent",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "AddMana",
                            "color": "RED",
                            "amount": {
                                "type": "Fixed",
                                "amount": 3
                            },
                            "expiry": "END_OF_COMBAT"
                        },
                        {
                            "type": "EmitBendEvent",
                            "bendType": "FIRE"
                        }
                    ]
                },
                "descriptionOverride": "Whenever this creature attacks, add {R}{R}{R}. Until end of combat, you don't lose this mana as steps and phases end."
            }
        ],
        "staticAbilities": [
            {
                "type": "GrantFlashToSpellType",
                "filter": "Ally|artifact",
                "controllerOnly": true
            }
        ]
    },
    "metadata": {
        "collectorNumber": "68",
        "rarity": "RARE",
        "artist": "Brian Yuen",
        "imageUri": "https://cards.scryfall.io/normal/front/4/b/4b50fe92-e596-4949-929b-54ae25a7992c.jpg?1783904839",
        "rulings": [
            {
                "date": "2025-10-02",
                "text": "Multiple instances of firebending on the same creature trigger separately, each granting you the appropriate amount of mana."
            },
            {
                "date": "2025-10-02",
                "text": "Firebending abilities aren't mana abilities. They use the stack and can be responded to."
            }
        ]
    },
    "colorIdentityOverride": [
        "BLUE",
        "BLACK",
        "RED"
    ]
}

